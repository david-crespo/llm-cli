{
  "tasks": {
    "ci": "deno fmt --check && deno lint && deno check && deno task test",
    "test": "deno test --allow-env --allow-read=/tmp --allow-write=/tmp"
  },
  "fmt": {
    "lineWidth": 92,
    "semiColons": false
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@1.2.1",
    "@cliffy/table": "jsr:@cliffy/table@1.2.1",
    "@david/dax": "jsr:@david/dax@^0.49.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/io": "jsr:@std/io@^0.225.3",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@shikijs/cli": "npm:@shikijs/cli@^4.4.3",
    "ansis": "npm:ansis@^4.3.1",
    "markdown-exit": "npm:markdown-exit@^1.3.0",
    "markdown-table": "https://esm.sh/markdown-table@3.0.4",
    "openai": "npm:openai@6.34.0",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@0.123.0",
    "arktype": "npm:arktype@^2.2.3",
    "json5": "npm:json5@^2.2.3",
    "@google/genai": "npm:@google/genai@2.21.0",
    "remeda": "npm:remeda@^2.45.0",
    "ts-pattern": "npm:ts-pattern@^5.9.0",
    "string-width": "https://esm.sh/string-width@7.2.0",
    "supports-hyperlinks": "npm:supports-hyperlinks@^4.5.0",
    "wrap-ansi": "https://esm.sh/wrap-ansi@9.0.0"
  }
}
